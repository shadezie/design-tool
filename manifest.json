{
  "manifest_version": 3,
  "name": "Design Tool",
  "version": "0.1.0",
  "description": "Figma-style inspection for any website. Hover for type styles, click two elements to measure the gap, see the spacing box.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Design Tool: inspect this page (Alt+Shift+D)",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle Design Tool inspect mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/ui/overlay-styles.js",
        "src/content/units.js",
        "src/content/styles.js",
        "src/content/measure.js",
        "src/content/overlay.js",
        "src/content/spacing-box.js",
        "src/content/card.js",
        "src/content/inspect.js",
        "src/content/index.js"
      ]
    }
  ]
}
